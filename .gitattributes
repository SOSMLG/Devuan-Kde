# Normalize text; keep platform scripts in their native line endings.
* text=auto eol=lf

*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.7z binary
*.gz binary
*.xz binary
*.iso binary
*.img binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
